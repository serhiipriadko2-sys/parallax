# Never commit real values.
OPENAI_API_KEY=
PARALLAX_API_KEY=
PARALLAX_ALLOWED_ORIGINS=https://chatgpt.com
PARALLAX_ENVIRONMENT=development
PARALLAX_MEMORY_BACKEND=disabled
PARALLAX_LOG_LEVEL=INFO
