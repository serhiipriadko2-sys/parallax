{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parallax-omega:eval-case:2.0",
  "title": "PARALLAX Omega behavioral eval case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "category",
    "severity",
    "mode",
    "prompt",
    "oracle",
    "control_refs",
    "tags"
  ],
  "properties": {
    "id": {
      "pattern": "^E[0-9]{3}$"
    },
    "schema_version": {
      "const": "2.0"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "mode": {
      "const": "behavioral_manual"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_behaviors",
        "forbidden_behaviors"
      ],
      "properties": {
        "required_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "control_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
